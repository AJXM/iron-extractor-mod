{
	"schemaVersion": 1,
	"id": "iron_extractor",
	"version": "${version}",
	"name": "Iron Extractor",
	"description": "序盤を少し有利にする小さな工業MOD",
	"authors": ["AJXM"],
	"license": "MIT",
"environment": "*",
	"entrypoints": {
		"main": ["com.ironextractor.IronExtractorMod"],
		"client": ["com.ironextractor.client.IronExtractorModClient"]
